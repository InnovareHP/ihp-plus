{
  "name": "ihp-plus",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ihp/web",
    "dev:landing": "turbo run dev --filter=@ihp/landing",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,astro,md,json,css}\"",
    "infra:up": "docker compose --env-file .env -f infra/compose.dev.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/compose.dev.yml down",
    "stack:up": "docker compose --env-file .env -f infra/compose.yml up --build",
    "stack:down": "docker compose --env-file .env -f infra/compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
