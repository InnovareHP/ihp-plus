---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const { title, description = 'IHP Plus' } = Astro.props
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="font-sans flex min-h-full flex-col bg-white text-neutral-900">
    <header class="border-b border-black/5">
      <nav class="mx-auto flex w-full max-w-5xl items-center justify-between p-4">
        <a href="/" class="font-semibold tracking-tight">IHP Plus</a>
        <a href="/app" class="text-brand-700 text-sm font-medium hover:underline">Open app →</a>
      </nav>
    </header>
    <slot />
    <footer class="border-t border-black/5 p-4 text-center text-xs opacity-60">
      © {new Date().getFullYear()} IHP Plus
    </footer>
  </body>
</html>
