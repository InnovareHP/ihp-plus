---
import Layout from '../layouts/Layout.astro'
import Contact from '../components/home/Contact.astro'
import RoleCard from '../components/careers/RoleCard.astro'
import Eyebrow from '../components/home/Eyebrow.astro'
import SiteFooter from '../components/home/SiteFooter.astro'
import SiteNav from '../components/home/SiteNav.astro'
import { fetchOpenRoles } from '../data/careers'

// Read once per build; the portal asks for a rebuild whenever an opening goes up or comes down.
const { roles, careersUrl, fetched } = await fetchOpenRoles()

const site = Astro.site ?? new URL('https://www.ihpplusglobal.com')
const graph = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Careers', item: new URL('/careers', site).href },
    ],
  },
]

const link =
  'rounded-sm font-semibold text-brand-700 underline underline-offset-4 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:outline-none'
---

<Layout
  title="Careers — IHP+ | Open roles"
  description="Work with IHP+ across marketing, technology and finance. See every open role and apply online."
  graph={graph}
>
  <SiteNav />

  <section
    class="relative isolate overflow-hidden rounded-b-[50px] bg-night text-white"
    aria-labelledby="careers-heading"
  >
    <div
      class="mx-auto flex max-w-[1280px] flex-col items-center gap-6 px-4 pt-40 pb-24 text-center sm:px-8 lg:px-[104px]"
    >
      <Eyebrow label="Careers" tone="light" />
      <h1 id="careers-heading" class="uppercase">
        <span class="block font-display text-[3rem] leading-[1] font-medium sm:text-[72px]">
          Build what's
        </span>
        <span
          class="font-poster text-brand-gradient block text-[3.75rem] leading-[1.05] font-extrabold tracking-[0.02em] sm:text-[96px]"
        >
          next with us
        </span>
      </h1>
      <p class="max-w-[640px] text-base text-white/80 sm:text-lg">
        Every role we are hiring for right now. Pick one to read the whole role and apply — it takes
        a few minutes, and you can check where your application stands at any time.
      </p>
    </div>
  </section>

  <section class="bg-canvas" aria-label="Open roles">
    <div class="mx-auto max-w-[1024px] px-4 py-16 sm:px-8 sm:py-20">
      {
        roles.length > 0 ? (
          <>
            <p class="mb-6 text-sm text-ink/70">
              {roles.length} {roles.length === 1 ? 'open role' : 'open roles'}
            </p>
            <ul class="flex flex-col gap-4">
              {roles.map((role) => (
                <RoleCard role={role} />
              ))}
            </ul>
          </>
        ) : fetched ? (
          <div class="rounded-[24px] bg-white p-8 text-center shadow-sm">
            <h2 class="font-display text-[1.75rem] font-semibold text-ink">
              No open roles right now
            </h2>
            <p class="mt-3 text-base text-ink/80">
              We post every new role here first. Check back soon, or tell us about yourself below.
            </p>
          </div>
        ) : (
          <div class="rounded-[24px] bg-white p-8 text-center shadow-sm">
            <h2 class="font-display text-[1.75rem] font-semibold text-ink">See our open roles</h2>
            <p class="mt-3 text-base text-ink/80">
              <a href={careersUrl} class={link}>
                View every open role on our careers portal
              </a>
            </p>
          </div>
        )
      }
    </div>
  </section>

  <Contact />
  <SiteFooter slot="footer" />
</Layout>

<script>
  // The shared motion script guards every section, so here it only fades in what this page has.
  import '../scripts/home-motion'
</script>
