---
import Layout from '../layouts/Layout.astro'
import Contact from '../components/home/Contact.astro'
import GlobalReach from '../components/home/GlobalReach.astro'
import Hero from '../components/home/Hero.astro'
import SiteNav from '../components/home/SiteNav.astro'
import HowWeWork from '../components/home/HowWeWork.astro'
import IndustriesMarquee from '../components/home/IndustriesMarquee.astro'
import SiteFooter from '../components/home/SiteFooter.astro'
import WhatWeDo from '../components/home/WhatWeDo.astro'
import WhoWeAre from '../components/home/WhoWeAre.astro'
import WhyIhp from '../components/home/WhyIhp.astro'
---

<Layout
  title="IHP+ — Powered by possibilities | Marketing, technology & finance, one team"
  description="IHP+ delivers integrated marketing, technology, and finance solutions to help businesses grow, streamline operations, and unlock new possibilities."
>
  <!-- Runs before the nav and hero parse; the timeout reveals it if the motion bundle never arrives. -->
  <script is:inline>
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      document.documentElement.classList.add('motion')
      setTimeout(() => document.documentElement.classList.remove('motion'), 3000)
    }
  </script>
  <SiteNav />
  <Hero />
  <WhoWeAre />
  <WhatWeDo />
  <WhyIhp />
  <GlobalReach />
  <IndustriesMarquee />
  <HowWeWork />
  <Contact />
  <SiteFooter slot="footer" />
</Layout>

<script>
  import '../scripts/home-motion'
</script>
