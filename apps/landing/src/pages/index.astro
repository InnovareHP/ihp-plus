---
import Layout from '../layouts/Layout.astro'
import { Button, Card } from '@ihp/ui'
---

<Layout title="IHP Plus — Landing">
  <div class="mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center gap-8 p-8">
    <div class="flex flex-col gap-4">
      <h1 class="text-5xl font-bold tracking-tight">Ship faster with IHP Plus</h1>
      <p class="max-w-xl text-lg opacity-70">
        Astro handles this marketing page as static HTML. Next.js handles the product at
        <code class="font-mono">/app</code>. One repo, one origin, two runtimes.
      </p>
      <div class="flex gap-3">
        <a href="/app"><Button size="lg">Get started</Button></a>
        <Button size="lg" variant="secondary">Book a demo</Button>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <Card title="Astro landing">Zero JS by default. Static output, CDN-friendly.</Card>
      <Card title="Next.js app">App Router, RSC, standalone Docker output.</Card>
      <Card title="Shared UI">One <code class="font-mono">@ihp/ui</code> package, both runtimes.</Card>
    </div>
  </div>
</Layout>
