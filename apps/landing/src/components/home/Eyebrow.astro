---
import flagGradient from '../../assets/home/eyebrow-flag-gradient.svg'
import flagBlue from '../../assets/home/eyebrow-flag-blue.svg'

interface Props {
  label: string
  /** Light text on the dark sections, ink on the light ones. */
  tone?: 'light' | 'dark'
  flag?: 'gradient' | 'blue'
}

const { label, tone = 'dark', flag = 'gradient' } = Astro.props
const icon = flag === 'gradient' ? flagGradient : flagBlue
---

<p
  class:list={[
    'flex items-center gap-2.5 text-base leading-5 tracking-[0.05em] uppercase',
    tone === 'light' ? 'text-white' : 'text-ink',
  ]}
>
  <img src={icon.src} width="28" height="16" alt="" class="h-4 w-7 shrink-0" />
  {label}
</p>
