---
import swirlLeft from '../../assets/home/swirl-left.svg'
import swirlRight from '../../assets/home/swirl-right.svg'
import DiamondArrow from './DiamondArrow.astro'
import Eyebrow from './Eyebrow.astro'
import SectionHeading from './SectionHeading.astro'
---

<section id="about" class="who relative bg-canvas" aria-labelledby="about-heading">
  <!-- Ribbons from the artwork, rotated as drawn; the right one tucks up behind the hero. -->
  <div class="who-swirl who-swirl-left" aria-hidden="true">
    <img src={swirlLeft.src} width="361" height="198" alt="" />
  </div>
  <div class="who-swirl who-swirl-right" aria-hidden="true">
    <img src={swirlRight.src} width="361" height="198" alt="" />
  </div>

  <div
    class="relative mx-auto grid max-w-[1280px] gap-4 px-4 pt-12 pb-28 sm:px-8 lg:grid-cols-[244px_1fr] lg:gap-0 lg:px-[118px] lg:pt-[48px] lg:pb-[117px]"
  >
    <div class="lg:pt-[19px]">
      <Eyebrow label="Who we are" />
    </div>
    <div class="max-w-[824px]">
      <SectionHeading
        id="about-heading"
        before="Where"
        highlight="vision"
        after="meets conversation."
      />
      <p class="mt-3 max-w-[756px] text-base">
        IHP+ was built on a simple idea — the businesses that grow fastest are the ones that see
        opportunity clearly and act on it without delay. We're the team businesses turn to for
        connected marketing, technology, and business solutions — delivering speed, impact, and
        results, with more capabilities added as our clients' needs grow, wherever they operate.
      </p>
    </div>
  </div>

  <DiamondArrow class="absolute -bottom-[86px] left-1/2 z-10 -translate-x-1/2" />
</section>

<style>
  .who {
    /* Clip sideways only, so the right ribbon can still rise behind the hero. */
    overflow-x: clip;
  }
  .who-swirl {
    position: absolute;
    display: none;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .who-swirl img {
    max-width: none;
    width: 361px;
    height: 198px;
  }
  @media (min-width: 1024px) {
    .who-swirl {
      display: flex;
    }
  }
  /* Offsets are the design's, measured from this section's top edge at the hero's foot. */
  .who-swirl-left {
    /* Hug the viewport edge up to 1280px, then stay beside the content on wider screens. */
    left: max(-168px, calc(50% - 808px));
    top: 37px;
    width: 411px;
    height: 361px;
  }
  .who-swirl-left img {
    rotate: -32.31deg;
  }
  .who-swirl-right {
    left: min(calc(100% - 115.5px), calc(50% + 700px));
    top: -206px;
    width: 397px;
    height: 393px;
  }
  .who-swirl-right img {
    rotate: -43.6deg;
  }
</style>
