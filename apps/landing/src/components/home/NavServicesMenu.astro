---
import { servicePath } from '../../data/services'

interface Props {
  /** The nav's shared link classes, so "Services" matches its neighbours. */
  linkClass: string
  class?: string
}

const { linkClass, class: className } = Astro.props

// Only IT has a page so far; the other two land on the homepage's services section.
const ITEMS = [
  {
    href: '/#services',
    label: 'Marketing & Creative',
    body: 'Strategy, content, and campaigns.',
  },
  {
    href: servicePath('it-web-solutions'),
    label: 'IT & Web Solutions',
    body: 'Websites, platforms, and IT support.',
  },
  {
    href: '/#services',
    label: 'Finance & Accounting',
    body: 'Bookkeeping, reporting, and payroll.',
  },
]
---

<!-- Static below sm, so the phone menu spans the nav bar instead of hanging off this link. -->
<li
  data-services-menu
  class:list={['group/menu relative inline-flex items-center gap-0.5 max-sm:static', className]}
>
  <a href="/#services" data-services-link class={linkClass}>Services</a>
  <button
    type="button"
    data-services-toggle
    aria-expanded="false"
    aria-controls="services-menu-panel"
    aria-label="Services menu"
    class="-my-2 grid size-8 place-items-center rounded-full text-white focus-visible:ring-2 focus-visible:ring-mint-300 focus-visible:outline-none"
  >
    <svg
      viewBox="0 0 12 12"
      class="size-3 transition-transform duration-200 group-hover/menu:rotate-180 group-has-[:focus-visible]/menu:rotate-180 group-data-[open]/menu:rotate-180 motion-reduce:transition-none"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M3 4.5l3 3 3-3"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <!-- Kept focusable while hidden, so Tab walks into it; keyboard focus opens it, a mouse click does not. -->
  <div
    id="services-menu-panel"
    class="services-menu pointer-events-none absolute top-full left-1/2 w-[300px] -translate-x-1/2 translate-y-1 pt-4 opacity-0 transition-[opacity,translate] duration-200 ease-out group-hover/menu:pointer-events-auto group-hover/menu:translate-y-0 group-hover/menu:opacity-100 group-has-[:focus-visible]/menu:pointer-events-auto group-has-[:focus-visible]/menu:translate-y-0 group-has-[:focus-visible]/menu:opacity-100 group-data-[open]/menu:pointer-events-auto group-data-[open]/menu:translate-y-0 group-data-[open]/menu:opacity-100 motion-reduce:transition-none max-sm:inset-x-0 max-sm:w-auto max-sm:translate-x-0 max-sm:pt-3"
  >
    <ul
      class="rounded-2xl border border-white/10 bg-night/95 p-2 shadow-xl shadow-black/30 supports-[backdrop-filter]:bg-night/80 supports-[backdrop-filter]:backdrop-blur-xl"
    >
      {
        ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-xl px-4 py-3 text-white transition-colors duration-150 hover:bg-white/10 focus-visible:bg-white/10 focus-visible:ring-2 focus-visible:ring-mint-300 focus-visible:outline-none motion-reduce:transition-none"
            >
              <span class="block text-sm font-semibold">{item.label}</span>
              <span class="mt-0.5 block text-xs text-white/70">{item.body}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</li>

<style>
  /* Escape hides the open menu until the pointer or focus leaves it (WCAG 1.4.13). */
  [data-services-menu][data-dismissed] .services-menu {
    pointer-events: none;
    opacity: 0;
  }
</style>

<script>
  for (const menu of document.querySelectorAll<HTMLElement>('[data-services-menu]')) {
    const link = menu.querySelector<HTMLElement>('[data-services-link]')
    const toggle = menu.querySelector<HTMLButtonElement>('[data-services-toggle]')
    const isOpen = () => 'open' in menu.dataset
    const setOpen = (open: boolean) => {
      if (open) menu.dataset.open = ''
      else delete menu.dataset.open
      toggle?.setAttribute('aria-expanded', String(open))
    }

    toggle?.addEventListener('click', () => setOpen(!isOpen()))
    // Touch screens have no hover, so tapping "Services" opens the list instead of leaving.
    link?.addEventListener('click', (event) => {
      if (!matchMedia('(hover: none)').matches) return
      event.preventDefault()
      setOpen(!isOpen())
    })
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) setOpen(false)
    })
    for (const item of menu.querySelectorAll('.services-menu a')) {
      item.addEventListener('click', () => setOpen(false))
    }

    const reset = () => delete menu.dataset.dismissed
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      setOpen(false)
      menu.dataset.dismissed = ''
      toggle?.focus()
    })
    menu.addEventListener('pointerleave', reset)
    menu.addEventListener('focusout', (event) => {
      if (!menu.contains(event.relatedTarget as Node | null)) reset()
    })
  }
</script>
