---
import { Image } from 'astro:assets'
import heroPhoto from '../../assets/home/hero-photo.png'
import bulge from '../../assets/home/hero-bulge.svg'
import SiteNav from './SiteNav.astro'
import StartBadge from './StartBadge.astro'
---

<section class="hero relative isolate z-10 bg-canvas" aria-labelledby="hero-heading">
  <!-- Rounded panel plus the bulge that cradles the badge: two masks over one photo, aligned. -->
  <div class="hero-panel absolute inset-x-0 top-0 overflow-hidden rounded-b-[50px]">
    <Image
      src={heroPhoto}
      alt=""
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-photo"
    />
  </div>
  <div class="hero-bulge absolute bottom-0 left-1/2" style={`--bulge: url(${bulge.src})`}>
    <Image src={heroPhoto} alt="" widths={[640, 1024, 1600]} sizes="100vw" class="hero-photo" />
  </div>

  <div class="relative flex h-full flex-col items-center px-4 text-center">
    <SiteNav />

    <img
      src="/brand/logo-on-dark.svg"
      width="90"
      height="55"
      alt="IHP+"
      class="mt-10 h-[55px] w-[90px] sm:mt-[62px]"
    />

    <h1 id="hero-heading" class="mt-6 flex flex-col items-center sm:mt-[23px]">
      <span
        class="font-display text-[2.75rem] leading-[1.1] font-medium text-white sm:text-[64px] sm:leading-[70px]"
      >
        POWERED BY
      </span>
      <span
        class="font-poster text-brand-gradient text-[3.5rem] leading-[1] font-extrabold tracking-[0.02em] sm:text-[100px] sm:leading-[128px]"
      >
        POSSIBILITIES
      </span>
    </h1>

    <p class="mt-6 max-w-[837px] text-base text-white sm:mt-5 sm:text-xl">
      IHP+ turns possibility into progress — pairing bold marketing with dependable technology to
      grow your brand and build your systems, all under one roof.
    </p>
  </div>

  <StartBadge
    variant="blue"
    class="absolute bottom-[22px] left-1/2 size-[167px] -translate-x-1/2"
  />
</section>

<style>
  .hero {
    /* Every photo layer is sized off the section, so the panel and the bulge line up exactly. */
    --hero-h: 640px;
    --bulge-h: 95px;
    --bulge-w: 237.26px;
    container-type: inline-size;
    height: var(--hero-h);
  }
  @media (min-width: 640px) {
    .hero {
      --hero-h: 700px;
    }
  }
  @media (min-width: 1024px) {
    .hero {
      --hero-h: 747px;
    }
  }

  .hero-panel {
    height: calc(var(--hero-h) - var(--bulge-h) + 1px);
  }
  .hero-bulge {
    width: var(--bulge-w);
    height: var(--bulge-h);
    translate: -50% 0;
    mask: var(--bulge) no-repeat center / 100% 100%;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100cqw;
    height: var(--hero-h);
    max-width: none;
    object-fit: cover;
    object-position: center bottom;
  }
  .hero-bulge .hero-photo {
    top: calc(var(--bulge-h) - var(--hero-h));
    left: calc(var(--bulge-w) / 2 - 50cqw);
  }
</style>
