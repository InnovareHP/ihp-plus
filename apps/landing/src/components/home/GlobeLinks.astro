---
/**
 * Light running between points on the globe artwork: the section's promise, drawn. Coordinates are
 * in the artwork's own 1327x942 frame, where the sphere sits at (664, 1107) with a ~497px radius.
 */
const NODES = {
  a: [470, 800],
  b: [620, 700],
  c: [780, 690],
  d: [905, 780],
  e: [560, 890],
  f: [760, 860],
  g: [1000, 900],
  h: [350, 905],
} as const

type Node = keyof typeof NODES

// Pairs chosen so the arcs cross each other; the second of each runs the other way round.
const LINKS: [Node, Node][] = [
  ['a', 'c'],
  ['d', 'b'],
  ['e', 'g'],
  ['h', 'b'],
  ['c', 'f'],
  ['g', 'a'],
  ['d', 'h'],
  ['f', 'e'],
]

// A flight path, not a chord: the curve rises above the surface in proportion to its span.
function arc(from: Node, to: Node) {
  const [x1, y1] = NODES[from]
  const [x2, y2] = NODES[to]
  const lift = Math.hypot(x2 - x1, y2 - y1) * 0.38
  const cx = (x1 + x2) / 2
  const cy = (y1 + y2) / 2 - lift
  return `M${x1} ${y1} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x2} ${y2}`
}

const links = LINKS.map(([from, to], index) => ({
  d: arc(from, to),
  // Staggered so the pulses never all fire together, and some pass each other mid-flight.
  delay: `${(index * 0.55).toFixed(2)}s`,
  duration: `${(3.2 + (index % 3) * 0.6).toFixed(1)}s`,
}))
---

<svg
  class="globe-links pointer-events-none absolute inset-0 size-full"
  viewBox="0 0 1327 942"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <filter id="globe-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="blur"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
  </defs>

  {links.map((link) => <path class="globe-route" d={link.d} pathLength="1" />)}

  <g filter="url(#globe-glow)">
    {
      links.map((link) => (
        <path
          class="globe-pulse"
          d={link.d}
          pathLength="1"
          style={`--delay: ${link.delay}; --duration: ${link.duration}`}
        />
      ))
    }
    {
      Object.values(NODES).map(([x, y], index) => (
        <circle
          class="globe-node"
          cx={x}
          cy={y}
          r="4"
          style={`--delay: ${(index * 0.4).toFixed(1)}s`}
        />
      ))
    }
  </g>
</svg>

<style>
  .globe-route {
    fill: none;
    stroke: #95e5dc;
    stroke-opacity: 0.22;
    stroke-width: 1.25;
  }

  /*
   * A short bright dash travels the route once per cycle, then rests before the next. With the
   * path normalised to length 1, an offset of 0.14 parks the dash just before the start and -1
   * just past the end.
   */
  .globe-pulse {
    fill: none;
    stroke: #eafffc;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 0.14 1;
    stroke-dashoffset: 0.14;
    animation: globe-pulse var(--duration) cubic-bezier(0.45, 0, 0.25, 1) var(--delay) infinite;
  }

  .globe-node {
    fill: #95e5dc;
    transform-box: fill-box;
    transform-origin: center;
    animation: globe-node 2.8s ease-in-out var(--delay) infinite;
  }

  @keyframes globe-pulse {
    0% {
      stroke-dashoffset: 0.14;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    75% {
      stroke-dashoffset: -1;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -1;
      opacity: 0;
    }
  }

  @keyframes globe-node {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.6);
    }
  }

  /* Still, the links read as a network; only the light stops moving. */
  @media (prefers-reduced-motion: reduce) {
    .globe-pulse {
      animation: none;
      opacity: 0;
    }
    .globe-node {
      animation: none;
      opacity: 0.8;
    }
    .globe-route {
      stroke-opacity: 0.4;
    }
  }
</style>
