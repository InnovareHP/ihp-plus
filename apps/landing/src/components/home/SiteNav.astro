---
import NavServicesMenu from './NavServicesMenu.astro'

// Rooted at "/" so the links also work from the service pages; every page has its own #contact.
const RIGHT = [
  { href: '/#global-reach', label: 'Global Reach' },
  { href: '#contact', label: 'Contact' },
]

const link =
  'rounded-sm text-[13px] text-white underline-offset-4 hover:underline focus-visible:ring-2 focus-visible:ring-mint-300 focus-visible:outline-none'
---

<!--
  A zero-height sticky wrapper: the bar follows the page without taking space, so the hero keeps
  the room it always had for it. Once scrolled, the same centred links sit in a frosted pill.
-->
<div class="sticky top-0 z-50 h-0">
  <nav
    aria-label="Primary"
    data-site-nav
    data-scrolled="false"
    class="group px-4 pt-6 sm:pt-[27px] data-[scrolled=true]:pt-3 sm:data-[scrolled=true]:pt-3"
  >
    <!-- The lockup sits under the links, so the design leaves the middle of the bar open for it. -->
    <ul
      class="relative mx-auto flex w-fit max-w-full flex-wrap items-center justify-center gap-x-6 gap-y-2 rounded-full border border-transparent transition-[background-color,border-color,box-shadow,backdrop-filter] duration-200 ease-out motion-reduce:transition-none sm:gap-x-12 lg:gap-x-0 group-data-[scrolled=true]:border-white/10 group-data-[scrolled=true]:bg-night/95 group-data-[scrolled=true]:px-6 group-data-[scrolled=true]:py-3 group-data-[scrolled=true]:shadow-lg group-data-[scrolled=true]:shadow-black/25 group-data-[scrolled=true]:supports-[backdrop-filter]:bg-night/65 group-data-[scrolled=true]:supports-[backdrop-filter]:backdrop-blur-xl group-data-[scrolled=true]:supports-[backdrop-filter]:backdrop-saturate-150 sm:group-data-[scrolled=true]:px-8"
    >
      <li class="lg:mr-12">
        <a href="/#about" class={link}>About</a>
      </li>
      <NavServicesMenu linkClass={link} class="lg:mr-[300px]" />
      {
        RIGHT.map((item, index) => (
          <li class={index === RIGHT.length - 1 ? '' : 'lg:mr-12'}>
            <a href={item.href} class={link}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style is:global>
  /* Anchored sections land below the bar rather than under it. */
  html {
    scroll-padding-top: 5rem;
  }
</style>

<script>
  // The only script the nav ships: it flips one attribute, and the classes above do the rest.
  const nav = document.querySelector<HTMLElement>('[data-site-nav]')
  if (nav) {
    let queued = false
    const update = () => {
      queued = false
      nav.dataset.scrolled = String(window.scrollY > 24)
    }
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return
        queued = true
        requestAnimationFrame(update)
      },
      { passive: true },
    )
    // A reload part-way down the page starts frosted, not clear.
    update()
  }
</script>
