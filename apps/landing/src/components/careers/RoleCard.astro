---
import type { OpenRole } from '../../data/careers'

interface Props {
  role: OpenRole
}

const { role } = Astro.props
const closes = role.closesAt
  ? new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' }).format(
      new Date(role.closesAt),
    )
  : null
const facts = [role.team, role.employmentType, role.workplace, role.location].filter(Boolean)
---

<li
  data-motion="fade"
  class="flex flex-col gap-4 rounded-[24px] border border-ink/10 bg-white p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between sm:p-8"
>
  <div class="min-w-0">
    <h2 class="font-display text-[1.75rem] leading-tight font-semibold text-ink">{role.title}</h2>
    <p class="mt-2 text-sm text-ink/70">{facts.join(' · ')}</p>
    {role.summary && <p class="mt-3 max-w-prose text-base text-ink">{role.summary}</p>}
    {
      (role.pay || closes) && (
        <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {role.pay && <span class="font-semibold text-ink">{role.pay}</span>}
          {closes && <span class="text-ink/70">Applications close {closes}</span>}
        </p>
      )
    }
  </div>
  <!-- Applying happens on the portal, where the form, uploads and status link live. -->
  <a
    href={role.url}
    class="inline-flex shrink-0 items-center justify-center rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700 focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:outline-none"
  >
    View and apply<span class="sr-only"> for {role.title}</span>
  </a>
</li>
