  >
  <a
  href="/"
  class="svc-rise block rounded-sm focus-visible:ring-2 focus-visible:ring-mint-300 focus-visible:ring-offset-4 focus-visible:ring-offset-night focus-visible:outline-none"
>
  <img src="/brand/logo-on-dark.svg" width="72" height="44" alt="IHP+ home" class="h-11 w-18" />
</a>
    <div>
      <div>
        <h1 id="service-heading" class="uppercase">
          <span
            class="svc-rise block font-display text-[3rem] leading-[1] font-medium sm:text-[72px] lg:text-[84px]"
            style="--d: 3">{plain}</span
