---
import type { Service } from '../../data/services'
import HeroBrowserDemo from './HeroBrowserDemo.astro'
import HeroLottie from './HeroLottie.astro'

interface Props {
  service: Service
}

const { service } = Astro.props
const [plain, gradient] = service.headline
---

<section class="svc-hero relative isolate overflow-hidden rounded-b-[50px] bg-night text-white">
  <div class="svc-glow absolute inset-0 -z-20" aria-hidden="true"></div>
  <HeroLottie src={service.backdrop} />

  <!-- Pinned under the sticky nav, so the headline alone decides the vertical centre. -->


  <div
