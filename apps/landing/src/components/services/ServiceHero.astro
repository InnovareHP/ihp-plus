<style>
  /* Static light behind the Lottie, so the first paint is already the right mood. */
  .svc-glow {
    background:
      radial-gradient(40% 45% at 50% 50%, rgb(19 70 197 / 0.35), transparent 70%),
      radial-gradient(45% 50% at 5% 100%, rgb(149 229 220 / 0.12), transparent 70%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc-rise {
      animation: svc-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--d, 0) * 0.08s);
    }
    .svc-dot {
      animation: svc-blink 1.6s ease-in-out infinite;
    }
  }

  @keyframes svc-rise {
    from {
      opacity: 0;
      translate: 0 28px;
      filter: blur(8px);
    }
  }
  @keyframes svc-blink {
    50% {
      opacity: 0.3;
    }
  }
</style>
