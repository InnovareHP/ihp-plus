---
interface Props {
  /** Checks the Launch stage ticks off, in order. */
  launchLog: string[]
}

const { launchLog } = Astro.props

const STAGES = ['Design', 'Build', 'Launch']
const DEVICES = [
  { id: 'desktop', label: 'Desktop preview', path: 'M3 4h14v9H3zM7 16h6M10 13v3' },
  {
    id: 'mobile',
    label: 'Mobile preview',
    path: 'M7 2.5h6a1 1 0 011 1v13a1 1 0 01-1 1H7a1 1 0 01-1-1v-13a1 1 0 011-1zM9.5 15h1',
  },
]
const ACCENTS = ['blue', 'mint', 'navy']
const FEATURES = ['Fast', 'Secure', 'Scalable']

const pill =
  'min-h-11 rounded-full px-3.5 text-xs font-semibold text-white/75 transition-colors duration-150 hover:text-white aria-pressed:bg-mint-300 aria-pressed:text-ink focus-visible:ring-2 focus-visible:ring-mint-300 focus-visible:outline-none motion-reduce:transition-none'
---

<div
  data-demo
  data-stage="build"
  data-device="desktop"
  data-accent="blue"
  role="group"
  aria-label="Interactive website demo"
  class="demo relative"
>
  <div class="demo-glow absolute -inset-6 rounded-[40px]" aria-hidden="true"></div>

  <div
    class="relative overflow-hidden rounded-[24px] border border-white/10 bg-white/[0.04] shadow-2xl shadow-black/40 backdrop-blur-xl"
  >
    <div class="flex items-center gap-3 border-b border-white/10 px-4 py-2">
      <span class="flex gap-1.5" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-white/25"></span>
        <span class="size-2.5 rounded-full bg-white/25"></span>
        <span class="size-2.5 rounded-full bg-mint-300"></span>
      </span>
      <p
        class="flex min-w-0 flex-1 items-center gap-2 rounded-full bg-white/5 px-3 py-1.5 font-mono text-[11px] text-white/70"
      >
        <svg viewBox="0 0 12 12" class="size-3 shrink-0" fill="none" aria-hidden="true">
          <rect x="2" y="5.5" width="8" height="5.5" rx="1" fill="currentColor"></rect>
          <path d="M4 5.5V4a2 2 0 014 0v1.5" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
        <span class="truncate">yourbrand.com</span>
        <span class="demo-live ml-auto items-center gap-1.5 text-mint-300">
          <span class="demo-live-dot size-1.5 rounded-full bg-mint-300"></span>live
        </span>
      </p>
      <div role="group" aria-label="Preview size" class="flex">
        {
          DEVICES.map((device) => (
            <button
              type="button"
              data-device-option={device.id}
              aria-pressed={device.id === 'desktop' ? 'true' : 'false'}
              aria-label={device.label}
              class="grid size-11 place-items-center rounded-full text-white/60 transition-colors duration-150 hover:text-white aria-pressed:text-mint-300 focus-visible:ring-2 focus-visible:ring-mint-300 focus-visible:outline-none motion-reduce:transition-none"
            >
              <svg viewBox="0 0 20 20" class="size-5" fill="none" aria-hidden="true">
                <path
                  d={device.path}
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          ))
        }
      </div>
    </div>

    <div
      class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 px-4 py-1.5"
    >
      <div role="group" aria-label="Project stage" class="flex rounded-full bg-white/5 p-0.5">
        {
          STAGES.map((stage) => (
            <button
              type="button"
              data-stage-option={stage.toLowerCase()}
              aria-pressed={stage === 'Build' ? 'true' : 'false'}
              class={pill}
            >
              {stage}
            </button>
          ))
        }
      </div>
      <div role="group" aria-label="Accent colour" class="flex">
        {
          ACCENTS.map((accent) => (
            <button
              type="button"
              data-accent-option={accent}
              aria-pressed={accent === 'blue' ? 'true' : 'false'}
              aria-label={`${accent[0]?.toUpperCase()}${accent.slice(1)} accent`}
              class="demo-swatch group/swatch grid size-11 place-items-center rounded-full focus-visible:ring-2 focus-visible:ring-mint-300 focus-visible:outline-none"
            >
              <span
                class={`demo-swatch-dot demo-swatch-${accent} size-5 rounded-full ring-2 ring-transparent ring-offset-2 ring-offset-night group-aria-pressed/swatch:ring-white`}
              />
            </button>
          ))
        }
      </div>
    </div>

    <div class="demo-stage relative h-[320px] p-3 sm:h-[340px] sm:p-4">
      <div data-demo-frame class="demo-frame mx-auto h-full overflow-hidden bg-white text-ink">
        <div class="flex h-full flex-col">
          <div class="demo-block flex items-center justify-between gap-3 px-4 py-3">
            <span class="flex items-center gap-2 text-sm font-semibold">
              <span class="demo-accent size-5 rounded-md" aria-hidden="true"></span>
              yourbrand
            </span>
            <span class="demo-links gap-3 text-[11px] text-ink/70" aria-hidden="true">
              <span>Work</span><span>Services</span><span>Contact</span>
            </span>
            <svg viewBox="0 0 16 16" class="demo-burger size-4" fill="none" aria-hidden="true">
              <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5"></path>
            </svg>
          </div>

          <div class="demo-block demo-hero mx-3 rounded-lg px-4 py-4">
            <p class="demo-title font-display text-[30px] leading-none font-extrabold uppercase">
              Launch faster.
            </p>
            <p class="mt-2 max-w-[30ch] text-xs text-ink/75">
              A site that loads fast, ranks well, and turns visits into leads.
            </p>
            <div class="mt-4 flex items-center gap-3">
              <button
                type="button"
                data-demo-cta
                class="demo-cta demo-accent min-h-9 rounded-full px-4 text-xs font-semibold focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 focus-visible:outline-none"
              >
                Get started
              </button>
              <span class="text-[11px] text-ink/75">
                Leads <strong data-demo-leads class="demo-leads inline-block text-ink">0</strong>
              </span>
            </div>
          </div>

          <ul class="demo-cards mt-3 grid gap-2 px-3 pb-3" aria-hidden="true">
            {
              FEATURES.map((feature) => (
                <li class="demo-block demo-card rounded-lg border border-brand-100 p-3">
                  <span class="demo-accent block size-4 rounded-full" />
                  <span class="mt-2 block text-xs font-semibold">{feature}</span>
                  <span class="mt-1.5 block h-1.5 w-4/5 rounded-full bg-brand-100" />
                  <span class="mt-1 block h-1.5 w-3/5 rounded-full bg-brand-100" />
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <pre
        class="demo-code absolute right-5 bottom-5 rounded-xl border border-white/10 bg-night/90 px-3.5 py-2.5 font-mono text-[11px] leading-5 text-white/80 shadow-xl shadow-black/30"
        aria-hidden="true"><span class="text-mint-300">&lt;Hero</span> accent=<span class="text-brand-300">"<span data-demo-code>blue</span>"</span> <span class="text-mint-300">/&gt;</span>
<span class="text-mint-300">&lt;Features</span> items=<span class="text-brand-300">{"{3}"}</span> <span class="text-mint-300">/&gt;</span></pre>

      <ul
        class="demo-log absolute top-5 right-5 space-y-1 rounded-xl border border-white/10 bg-night/90 px-3.5 py-2.5 font-mono text-[11px] leading-5 shadow-xl shadow-black/30"
        aria-hidden="true"
      >
        {
          launchLog.map((line, index) => (
            <li
              class:list={[line.startsWith('✓') ? 'text-mint-300' : 'text-white/80']}
              style={`--i: ${index}`}
            >
              {line}
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="flex items-center justify-between gap-3 border-t border-white/10 px-4 py-1 font-mono text-[11px] text-white/70"
    >
      <span>Click around — it's live.</span>
      <button
        type="button"
        data-demo-pause
        aria-pressed="false"
        class="demo-pause min-h-11 rounded-full px-2 text-white/80 hover:text-white focus-visible:ring-2 focus-visible:ring-mint-300 focus-visible:outline-none"
      >
        Pause tour
      </button>
    </div>
  </div>

  <span
    data-demo-cursor
    class="demo-cursor pointer-events-none absolute top-0 left-0 z-20"
    aria-hidden="true"
  >
    <svg viewBox="0 0 24 24" class="size-6 drop-shadow-lg" fill="none">
      <path
        d="M4 3l15 7.5-6.5 1.8L10 19z"
        fill="#fff"
        stroke="var(--color-night)"
        stroke-width="1.5"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</div>

<style>
  .demo {
    --accent: var(--color-brand-600);
    --on-accent: #fff;
  }
  .demo[data-accent='mint'] {
    --accent: var(--color-mint-300);
    --on-accent: var(--color-ink);
  }
  .demo[data-accent='navy'] {
    --accent: var(--color-brand-800);
    --on-accent: #fff;
  }
  .demo-swatch-blue {
    background: var(--color-brand-600);
  }
  .demo-swatch-mint {
    background: var(--color-mint-300);
  }
  .demo-swatch-navy {
    background: var(--color-brand-800);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
  }

  .demo-glow {
    background: conic-gradient(
      from 200deg,
      var(--color-brand-600),
      var(--color-mint-300),
      var(--color-brand-800),
      var(--color-brand-600)
    );
    filter: blur(48px);
    opacity: 0.35;
  }

  .demo-frame {
    container-type: inline-size;
    border-radius: 12px;
  }
  .demo-accent {
    background: var(--accent);
    color: var(--on-accent);
    transition: background-color 250ms ease-out;
  }
  .demo-hero {
    background: color-mix(in oklab, var(--accent) 10%, white);
    transition: background-color 250ms ease-out;
  }
  .demo-links {
    display: flex;
  }
  .demo-burger {
    display: none;
  }
  .demo-cards {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* The phone preview is the same page in a narrow frame; the container query does the reflow. */
  .demo[data-device='mobile'] .demo-frame {
    max-width: 220px;
    border-radius: 26px;
    box-shadow: 0 0 0 6px rgb(255 255 255 / 0.12);
  }
  @container (max-width: 300px) {
    .demo-links {
      display: none;
    }
    .demo-burger {
      display: block;
    }
    .demo-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Design is the wireframe: the same layout, outlined and greyed, before any colour lands. */
  .demo[data-stage='design'] {
    --accent: var(--color-brand-100);
    --on-accent: var(--color-brand-700);
  }
  .demo[data-stage='design'] .demo-frame {
    background: var(--color-canvas);
  }
  .demo[data-stage='design'] .demo-block {
    outline: 1.5px dashed var(--color-brand-300);
    outline-offset: -1.5px;
  }
  .demo[data-stage='design'] .demo-hero {
    background: transparent;
  }
  .demo[data-stage='design'] .demo-title {
    color: var(--color-brand-700);
  }

  .demo-code,
  .demo-log,
  .demo-live {
    display: none;
  }
  .demo[data-stage='build'] .demo-code,
  .demo[data-stage='launch'] .demo-log {
    display: block;
  }
  .demo[data-stage='launch'] .demo-live {
    display: inline-flex;
  }

  .demo-cursor {
    opacity: 0;
    translate: 60% 70%;
    transition:
      translate 800ms cubic-bezier(0.65, 0, 0.35, 1),
      opacity 250ms ease-out;
  }
  .demo-cursor[data-visible] {
    opacity: 1;
  }
  .demo-cursor::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border: 2px solid var(--color-mint-300);
    border-radius: 9999px;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .demo-frame.demo-swap {
      animation: demo-swap 350ms ease-out;
    }
    .demo[data-stage] .demo-code,
    .demo[data-stage] .demo-log li {
      animation: demo-in 400ms ease-out both;
      animation-delay: calc(var(--i, 0) * 250ms);
    }
    .demo-live-dot {
      animation: demo-blink 1.4s ease-in-out infinite;
    }
    .demo-leads.demo-bump {
      animation: demo-bump 400ms ease-out;
    }
    .demo-cursor.demo-click svg {
      animation: demo-press 300ms ease-out;
    }
    .demo-cursor.demo-click::after {
      animation: demo-ring 500ms ease-out;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-cursor,
    .demo-pause {
      display: none;
    }
  }

  @keyframes demo-swap {
    from {
      opacity: 0;
      scale: 0.97;
    }
  }
  @keyframes demo-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  @keyframes demo-blink {
    50% {
      opacity: 0.3;
    }
  }
  @keyframes demo-bump {
    40% {
      scale: 1.5;
      color: var(--color-brand-600);
    }
  }
  @keyframes demo-press {
    50% {
      scale: 0.8;
    }
  }
  @keyframes demo-ring {
    from {
      opacity: 1;
      scale: 0.3;
    }
    to {
      opacity: 0;
      scale: 1.4;
    }
  }
</style>

<script>
  // Each step is a real control; the tour clicks it exactly as a visitor would.
  const TOUR = [
    '[data-stage-option="design"]',
    '[data-stage-option="build"]',
    '[data-accent-option="mint"]',
    '[data-demo-cta]',
    '[data-device-option="mobile"]',
    '[data-demo-cta]',
    '[data-device-option="desktop"]',
    '[data-accent-option="blue"]',
    '[data-stage-option="launch"]',
  ]
  const GROUPS = ['stage', 'device', 'accent'] as const

  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
  const replay = (element: Element, className: string) => {
    element.classList.remove(className)
    void (element as HTMLElement).offsetWidth
    element.classList.add(className)
  }

  for (const demo of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    const frame = demo.querySelector<HTMLElement>('[data-demo-frame]')
    const leads = demo.querySelector<HTMLElement>('[data-demo-leads]')
    const code = demo.querySelector<HTMLElement>('[data-demo-code]')
    const cursor = demo.querySelector<HTMLElement>('[data-demo-cursor]')
    const pause = demo.querySelector<HTMLButtonElement>('[data-demo-pause]')
    let count = 0

    demo.addEventListener('click', (event) => {
      const button = (event.target as Element).closest('button')
      if (!button) return
      for (const group of GROUPS) {
        const value = button.getAttribute(`data-${group}-option`)
        if (!value) continue
        demo.dataset[group] = value
        for (const option of demo.querySelectorAll(`[data-${group}-option]`)) {
          option.setAttribute('aria-pressed', String(option === button))
        }
        if (group === 'device' && frame) replay(frame, 'demo-swap')
        if (group === 'accent' && code) code.textContent = value
      }
      if (button.hasAttribute('data-demo-cta') && leads) {
        count += 1
        leads.textContent = String(count)
        replay(leads, 'demo-bump')
      }
    })

    if (!cursor || !pause || matchMedia('(prefers-reduced-motion: reduce)').matches) continue

    let paused = false
    let engaged = false
    let visible = false
    let release: ReturnType<typeof setTimeout> | undefined

    const hideCursor = () => delete cursor.dataset.visible
    const engage = () => {
      clearTimeout(release)
      engaged = true
      hideCursor()
    }
    // The visitor's own pointer or focus takes over; the tour resumes a moment after they leave.
    const disengage = () => {
      clearTimeout(release)
      release = setTimeout(() => (engaged = false), 2500)
    }
    demo.addEventListener('pointerenter', engage)
    demo.addEventListener('pointerleave', disengage)
    demo.addEventListener('focusin', engage)
    demo.addEventListener('focusout', (event) => {
      if (!demo.contains(event.relatedTarget as Node | null)) disengage()
    })

    pause.addEventListener('click', () => {
      paused = !paused
      pause.setAttribute('aria-pressed', String(paused))
      pause.textContent = paused ? 'Play tour' : 'Pause tour'
      if (paused) hideCursor()
    })

    new IntersectionObserver(([entry]) => (visible = entry?.isIntersecting ?? false), {
      threshold: 0.3,
    }).observe(demo)

    const idle = () => paused || engaged || !visible || document.hidden

    const tour = async () => {
      await wait(2200)
      for (let step = 0; ; step = (step + 1) % TOUR.length) {
        while (idle()) await wait(400)
        const selector = TOUR[step]
        const target = selector ? demo.querySelector<HTMLElement>(selector) : null
        if (!target) continue

        const box = demo.getBoundingClientRect()
        const spot = target.getBoundingClientRect()
        cursor.style.translate = `${spot.left - box.left + spot.width / 2}px ${spot.top - box.top + spot.height / 2}px`
        cursor.dataset.visible = ''
        await wait(900)
        if (idle()) continue

        replay(cursor, 'demo-click')
        target.click()
        await wait(step === TOUR.length - 1 ? 3600 : 1400)
      }
    }
    void tour()
  }
</script>
