---
interface Props {
  file: string
  lines: string[]
  tags: string[]
}

const { file, lines, tags } = Astro.props
---

<!-- Pure decoration: the same facts are in the hero copy and the capabilities list. -->
<div class="console-wrap relative" aria-hidden="true">
  <div class="console-glow absolute -inset-6 rounded-[40px]"></div>

  <div
    class="console relative overflow-hidden rounded-[24px] border border-white/10 bg-white/[0.04] shadow-2xl shadow-black/40 backdrop-blur-xl"
  >
    <div class="flex items-center gap-2 border-b border-white/10 px-5 py-3.5">
      <span class="size-2.5 rounded-full bg-white/25"></span>
      <span class="size-2.5 rounded-full bg-white/25"></span>
      <span class="size-2.5 rounded-full bg-mint-300"></span>
      <span class="ml-3 font-mono text-xs text-white/60">ihp+/{file}</span>
      <span class="ml-auto flex items-center gap-1.5 font-mono text-[11px] text-mint-300">
        <span class="console-pulse size-1.5 rounded-full bg-mint-300"></span>
        live
      </span>
    </div>

    <div class="space-y-2.5 px-5 pt-5 pb-4 font-mono text-[13px] leading-5 sm:text-sm">
      {
        lines.map((line, index) => (
          <p
            class:list={[
              'console-line whitespace-nowrap',
              line.startsWith('✓')
                ? 'text-mint-300'
                : line.startsWith('→')
                  ? 'text-white'
                  : 'text-white/70',
            ]}
            style={`--i: ${index}`}
          >
            {line}
            {index === lines.length - 1 && <span class="console-caret" />}
          </p>
        ))
      }
    </div>

    <div class="grid grid-cols-[1fr_auto] items-end gap-5 border-t border-white/10 px-5 py-5">
      <svg viewBox="0 0 240 64" class="h-16 w-full" fill="none" preserveAspectRatio="none">
        <defs>
          <linearGradient id="console-stroke" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="var(--color-brand-400)"></stop>
            <stop offset="1" stop-color="var(--color-mint-300)"></stop>
          </linearGradient>
          <linearGradient id="console-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--color-mint-300)" stop-opacity="0.25"></stop>
            <stop offset="1" stop-color="var(--color-mint-300)" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <path
          class="console-area"
          d="M0 54 L30 48 L60 50 L90 38 L120 41 L150 28 L180 30 L210 16 L240 8 L240 64 L0 64 Z"
          fill="url(#console-fill)"></path>
        <path
          class="console-spark"
          d="M0 54 L30 48 L60 50 L90 38 L120 41 L150 28 L180 30 L210 16 L240 8"
          stroke="url(#console-stroke)"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          pathLength="1"></path>
      </svg>
      <div class="flex h-16 items-end gap-1.5">
        {
          [40, 62, 48, 80, 70, 100].map((height, index) => (
            <span
              class="console-bar w-2.5 rounded-t-sm bg-gradient-to-t from-brand-600 to-mint-300"
              style={`height: ${height}%; --i: ${index}`}
            />
          ))
        }
      </div>
    </div>
  </div>

  <ul class="console-tags pointer-events-none absolute inset-0 hidden lg:block">
    {
      tags.map((tag, index) => (
        <li
          class="console-tag absolute rounded-full border border-white/15 bg-night/80 px-3.5 py-1.5 font-mono text-xs text-white backdrop-blur-md"
          style={`--i: ${index}`}
        >
          <span class="mr-1.5 text-mint-300">#</span>
          {tag}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .console-glow {
    background: conic-gradient(
      from 200deg,
      var(--color-brand-600),
      var(--color-mint-300),
      var(--color-brand-800),
      var(--color-brand-600)
    );
    filter: blur(48px);
    opacity: 0.35;
  }

  .console-pulse {
    box-shadow: 0 0 0 0 var(--color-mint-300);
  }

  .console-caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.3em;
    vertical-align: -0.15em;
    background: var(--color-mint-300);
  }

  .console-spark {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  /* Tags orbit the panel's edges at the design's resting points. */
  .console-tag:nth-child(1) {
    top: -18px;
    left: 8%;
  }
  .console-tag:nth-child(2) {
    top: 22%;
    right: -40px;
  }
  .console-tag:nth-child(3) {
    bottom: 30%;
    left: -48px;
  }
  .console-tag:nth-child(4) {
    bottom: -18px;
    right: 14%;
  }
  .console-tag:nth-child(5) {
    top: 52%;
    right: -64px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .console-pulse {
      animation: console-pulse 2s ease-out infinite;
    }
    .console-caret {
      animation: console-blink 1s steps(1) infinite;
    }
    .console-line {
      animation: console-type 0.7s steps(24) both;
      animation-delay: calc(0.9s + var(--i) * 0.45s);
    }
    .console-spark {
      animation: console-draw 1.6s ease-out 1.4s both;
    }
    .console-area {
      animation: console-fade 1.2s ease-out 2.2s both;
    }
    .console-bar {
      transform-origin: bottom;
      animation: console-grow 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(1.6s + var(--i) * 0.08s);
    }
    .console-tag {
      animation:
        console-fade 0.8s ease-out both,
        console-float 6s ease-in-out infinite;
      animation-delay: calc(1.2s + var(--i) * 0.15s), calc(var(--i) * -1.2s);
    }
  }

  @keyframes console-pulse {
    70%,
    100% {
      box-shadow: 0 0 0 6px transparent;
    }
  }
  @keyframes console-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes console-type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes console-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  @keyframes console-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes console-grow {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes console-float {
    50% {
      translate: 0 -8px;
    }
  }
</style>
