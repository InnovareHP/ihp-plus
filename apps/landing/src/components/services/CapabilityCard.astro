---
interface Props {
  index: number
  title: string
  body: string
}

const { index, title, body } = Astro.props
---

<li
  data-motion="fade"
  class="capability group relative overflow-hidden rounded-[20px] border border-brand-100 bg-white p-6 transition-[border-color,box-shadow,translate] duration-200 ease-out hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl hover:shadow-brand-600/10 motion-reduce:transition-none sm:p-7"
>
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gradient-to-r from-brand-600 to-mint-300 transition-transform duration-200 ease-out group-hover:scale-x-100 motion-reduce:transition-none"
  ></span>
  <span class="font-mono text-sm text-brand-700" aria-hidden="true">
    {String(index + 1).padStart(2, '0')}
  </span>
  <h3 class="mt-4 font-display text-[28px] leading-[1.1] font-semibold text-brand-600">{title}</h3>
  <p class="mt-3 text-base leading-relaxed text-ink">{body}</p>
</li>
