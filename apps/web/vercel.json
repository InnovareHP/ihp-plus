{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/.well-known/microsoft-identity-association.json",
      "destination": "/app/api/microsoft-identity-association"
    }
  ],
  "crons": [
    { "path": "/app/api/cron/attendance-reminders", "schedule": "0 2 * * *" },
    { "path": "/app/api/cron/attendance-reminders", "schedule": "0 11 * * *" },
    { "path": "/app/api/cron/holidays", "schedule": "0 3 1 12 *" },
    { "path": "/app/api/cron/celebrations", "schedule": "30 0 * * *" },
    { "path": "/app/api/cron/hiring-retention", "schedule": "0 4 * * *" },
    { "path": "/app/api/cron/hiring-interviews", "schedule": "15 1 * * *" },
    { "path": "/app/api/cron/hiring-interviews", "schedule": "15 9 * * *" },
    { "path": "/app/api/cron/website-checks?round=clock_in", "schedule": "0 1 * * 5,6,0" },
    { "path": "/app/api/cron/website-checks?round=clock_out", "schedule": "0 10 * * 5,6,0" }
  ]
}
