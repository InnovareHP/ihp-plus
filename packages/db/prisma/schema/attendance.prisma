// The daily clock: one row per person per working day, with the breaks taken inside it. Task
// time in tasks.prisma answers "what was this hour spent on"; this answers "was this person at
// work today", which is the payroll question and a different table.

// What is true of the whole company rather than of one shift: which midnight ends a day, and
// which shift somebody works until they are given one of their own.
model AttendanceSettings {
  organizationId String @id

  // The zone a working day is counted in, so midnight means the same thing to everyone here.
  timeZone String @default("UTC")

  defaultShiftId String?
  defaultShift   AttendanceShift? @relation("DefaultShift", fields: [defaultShiftId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendanceSettings")
  @@schema("attendance")
}

// A named set of working hours and the clock rules that go with them, written once and given to
// as many people as work them. Rules belong here rather than to the company: a night shift can
// ask for a selfie while the office shift does not.
model AttendanceShift {
  id             String @id @default(uuid())
  organizationId String

  name String

  shiftStartMinutes Int
  shiftEndMinutes   Int
  graceMinutes      Int    @default(15)
  // Weekdays worked as a comma list, 0 being Sunday.
  workdays          String @default("1,2,3,4,5")

  // A selfie at each end proves who pressed the button; off is one tap.
  requireSelfie     Boolean @default(false)
  requireNote       Boolean @default(false)
  captureLocation   Boolean @default(false)
  // Hours after which a day nobody clocked out of is closed at that length; 0 never closes one.
  autoClockOutHours Int     @default(16)
  // Emails whoever works it when they have not clocked in, or are still clocked in, past the hour.
  sendReminders     Boolean @default(true)
  // ISO country whose public holidays this shift gets off, such as "PH"; empty follows only the
  // company-wide days.
  holidayCountry    String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments  AttendanceSchedule[]
  defaultOf    AttendanceSettings[] @relation("DefaultShift")

  // Two shifts called "Morning" in one company is a naming mistake, not a second shift.
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("attendanceShift")
  @@schema("attendance")
}

// Who works which shift; absent means they work the company hours in Settings.
model AttendanceSchedule {
  id             String @id @default(uuid())
  organizationId String
  userId         String

  shiftId String
  shift   AttendanceShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([shiftId])
  @@map("attendanceSchedule")
  @@schema("attendance")
}

// A day at work. No clockOutAt means the person is still on the clock.
model AttendanceDay {
  id             String @id @default(uuid())
  organizationId String
  userId         String

  // The day the shift belongs to, so a night shift ending after midnight still counts here.
  workDate   DateTime  @db.Date
  clockInAt  DateTime
  clockOutAt DateTime?

  // Stored rather than derived: a corrected timestamp must not silently restate paid hours.
  workedSeconds Int @default(0)
  breakSeconds  Int @default(0)
  lateSeconds   Int @default(0)

  // open while the clock runs, recorded once it stops.
  status String @default("open")
  // clock when the buttons produced it, manual when somebody wrote it up.
  source String @default("clock")
  // True when nobody clocked out and the shift's limit closed the day, until an admin corrects it.
  autoClosed Boolean @default(false)
  note   String?

  clockInSelfieKey  String?
  clockOutSelfieKey String?
  clockInLocation   String?
  clockOutLocation  String?

  editedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breaks AttendanceBreak[]

  // One day per person per date is what the clock buttons and the admin edit both assume.
  @@unique([userId, workDate])
  @@index([organizationId, workDate])
  // Finding the person's open day is a query by this pair.
  @@index([userId, clockOutAt])
  @@map("attendanceDay")
  @@schema("attendance")
}

// A break inside a day; one with no endedAt is the break currently being taken.
model AttendanceBreak {
  id    String        @id @default(uuid())
  dayId String
  day   AttendanceDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  startedAt DateTime
  endedAt   DateTime?
  seconds   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayId, startedAt])
  @@map("attendanceBreak")
  @@schema("attendance")
}

// A day off: for everyone when country is empty, otherwise only for shifts following that country.
model AttendanceHoliday {
  id             String   @id @default(uuid())
  organizationId String
  date           DateTime @db.Date
  name           String
  // Empty rather than null so the unique index below treats "everyone" as one value.
  country        String   @default("")
  // manual when an admin typed it, imported when it came from the public holiday calendar.
  source         String   @default("manual")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Two names for one day off in one calendar is a typo, not two holidays.
  @@unique([organizationId, date, country])
  @@index([organizationId, date])
  @@map("attendanceHoliday")
  @@schema("attendance")
}

// Which country's calendar was filled for which year, so a day an admin deleted is not put back.
model AttendanceHolidayImport {
  id             String @id @default(uuid())
  organizationId String
  country        String
  year           Int

  importedAt DateTime @default(now())

  @@unique([organizationId, country, year])
  @@map("attendanceHolidayImport")
  @@schema("attendance")
}

// A day one person is off with approval, written when a time off request is approved.
model AttendanceLeave {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  date           DateTime @db.Date
  // The form it came through, such as "Vacation leave", which is what the timesheet shows.
  name           String
  // Plain column, not a relation: requests live in another Postgres schema.
  submissionId   String?

  createdAt DateTime @default(now())

  // Overlapping approvals book the day once.
  @@unique([userId, date])
  @@index([organizationId, date])
  @@index([submissionId])
  @@map("attendanceLeave")
  @@schema("attendance")
}

// One row per reminder sent, so a restarted or second worker never emails the same thing twice.
model AttendanceReminder {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  // The work day the reminder is about, in the organization's zone.
  workDate       DateTime @db.Date
  // clock_in or clock_out.
  kind           String

  sentAt DateTime @default(now())

  @@unique([userId, workDate, kind])
  @@index([organizationId, workDate])
  @@map("attendanceReminder")
  @@schema("attendance")
}

// A member asking for one of their own days to be put right; an admin applies it or turns it down.
model AttendanceCorrection {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  workDate       DateTime @db.Date

  // Wall clock times, as the admin's own correction form takes them.
  clockInTime  String
  clockOutTime String
  breakMinutes Int    @default(0)
  reason       String

  // pending, approved, rejected or withdrawn.
  status       String    @default("pending")
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([userId, workDate])
  @@map("attendanceCorrection")
  @@schema("attendance")
}
