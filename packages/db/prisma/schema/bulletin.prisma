// The company bulletin board: one feed everyone in the organization reads, answers and reacts
// to, with admins pinning what must stay on top.

model BulletinPost {
  id             String  @id @default(uuid())
  // Plain columns, not relations: a relation field would have to be added to the generated
  // User and Organization models in auth.prisma.
  organizationId String
  // Null on a post the portal wrote itself, such as a birthday.
  authorId       String?

  // post | birthday | anniversary | welcome; anything but "post" was written by the daily job.
  kind          String  @default("post")
  // Who a celebration is about, so the card can name and picture them.
  subjectUserId String?
  // e.g. "birthday:<userId>:2026" — unique per organization, so a rerun of the job never doubles up.
  occasionKey   String?

  body     String
  // Set on the first edit, so the UI can say "edited" without comparing timestamps.
  editedAt DateTime?

  // A timestamp rather than a flag: the newest pin sorts first among the pinned.
  pinnedAt   DateTime?
  pinnedById String?

  // An admin asked everyone to confirm they have read it, as with a policy change.
  requiresAck Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments         BulletinComment[]
  reactions        BulletinReaction[]
  images           BulletinImage[]
  mentions         BulletinMention[]
  acknowledgements BulletinAcknowledgement[]

  @@unique([organizationId, occasionKey])
  @@index([organizationId, pinnedAt, createdAt])
  @@map("bulletinPost")
  @@schema("bulletin")
}

// Replies are flat under a post: the post is already the thread.
model BulletinComment {
  id             String       @id @default(uuid())
  organizationId String
  postId         String
  post           BulletinPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  body     String
  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentions BulletinMention[]

  @@index([postId, createdAt])
  @@map("bulletinComment")
  @@schema("bulletin")
}

// One row per person per emoji on a post, so reacting twice with the same emoji is a no-op.
model BulletinReaction {
  id     String       @id @default(uuid())
  postId String
  post   BulletinPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  emoji  String

  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@map("bulletinReaction")
  @@schema("bulletin")
}

// A photo on a post. Uploaded before the post exists, so it waits unclaimed until posting claims it.
model BulletinImage {
  id             String        @id @default(uuid())
  organizationId String
  postId         String?
  post           BulletinPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  fileKey      String
  contentType  String
  fileSize     Int
  uploadedById String
  // Order in the post's grid, as the author picked them.
  position     Int    @default(0)

  createdAt DateTime @default(now())

  @@index([postId, position])
  @@index([organizationId, uploadedById])
  @@map("bulletinImage")
  @@schema("bulletin")
}

// Which automatic posts an organization wants; one row per organization, created on first read.
model BulletinSettings {
  organizationId String @id

  celebrateBirthdays     Boolean @default(true)
  celebrateAnniversaries Boolean @default(true)
  welcomeNewHires        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bulletinSettings")
  @@schema("bulletin")
}

// Who a post or reply called on by name. Its own table because the unread badge is a query by
// person; commentId is null when the mention is in the post itself.
model BulletinMention {
  id             String           @id @default(uuid())
  organizationId String
  postId         String
  post           BulletinPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId      String?
  comment        BulletinComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId         String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([postId])
  @@index([commentId])
  @@map("bulletinMention")
  @@schema("bulletin")
}

/// One person confirming they read one post; unique per pair, so confirming twice is a no-op.
model BulletinAcknowledgement {
  id             String       @id @default(uuid())
  postId         String
  post           BulletinPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId         String
  acknowledgedAt DateTime     @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("bulletinAcknowledgement")
  @@schema("bulletin")
}

// When each person last opened the board, so the sidebar can count what arrived since.
model BulletinReadState {
  organizationId String
  userId         String
  lastSeenAt     DateTime

  @@id([organizationId, userId])
  @@map("bulletinReadState")
  @@schema("bulletin")
}
