// The company bluebook: the handbook every employee reads, in its own Postgres schema. It
// stays out of auth.prisma because `pnpm db:auth-schema` rewrites that file wholesale.

model BluebookDocument {
  id             String @id @default(uuid())
  organizationId String
  // A document sits on as many department shelves as it applies to. No rows is the
  // company-wide shelf every department reads, which is what a null teamId used to mean.
  teams          BluebookDocumentTeam[]

  title       String
  description String?
  /// A value from the bluebookCategory lookup list, stored as plain text.
  category    String?

  /// Object storage key; the file itself never touches Postgres.
  fileKey     String
  fileName    String
  contentType String
  byteSize    Int

  uploadedById   String?
  uploadedByName String?

  // Archiving rather than deleting: a document someone linked to stays accounted for, and the
  // object is removed from storage only when an admin purges it.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([organizationId, archivedAt])
  @@index([organizationId, category])
  @@map("bluebookDocument")
  @@schema("bluebook")
}

/// Which department shelves one document sits on.
model BluebookDocumentTeam {
  id         String           @id @default(uuid())
  documentId String
  document   BluebookDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  teamId     String
  // Snapshot: a department renamed or deleted later must still label the document it holds.
  teamName   String

  @@unique([documentId, teamId])
  @@index([teamId])
  @@map("bluebookDocumentTeam")
  @@schema("bluebook")
}
