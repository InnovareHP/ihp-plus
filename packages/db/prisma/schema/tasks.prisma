// Work the company assigns itself: a project holds lists, a list holds tasks, and a task
// carries the conversation about it. Modelled on the task board in the referral portal, minus
// its checklists, timers and dependency graph — those land in a later pass.

model TaskProject {
  id String @id @default(uuid())
  // Plain columns, not relations: a relation field would have to be added to the generated
  // User and Organization models in auth.prisma.
  organizationId String
  createdById    String?

  name      String
  // Hex, shown as the project's dot in the switcher.
  color     String?
  sortOrder Int     @default(0)
  // Task numbers read #1, #2 … per project, so the next one is counted here rather than by
  // scanning the tasks table under a race.
  taskCounter Int  @default(0)
  isArchived  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lists TaskList[]
  tasks Task[]

  @@index([organizationId, isArchived])
  @@map("taskProject")
  @@schema("tasks")
}

// The columns of a board. A project always has at least one, because a task has to land
// somewhere.
model TaskList {
  id        String      @id @default(uuid())
  projectId String
  project   TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  organizationId String
  name           String
  sortOrder      Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([projectId])
  @@index([organizationId])
  @@map("taskList")
  @@schema("tasks")
}

// Statuses are the organization's own words, shared by every project, and seeded on first use.
// `category` is what the app reasons about: "active", "done" or "cancelled".
model TaskStatus {
  id             String @id @default(uuid())
  organizationId String

  name      String
  color     String
  category  String @default("active")
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("taskStatus")
  @@schema("tasks")
}

model Task {
  id             String @id @default(uuid())
  organizationId String

  projectId String
  project   TaskProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  listId    String
  list      TaskList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  statusId  String
  status    TaskStatus  @relation(fields: [statusId], references: [id], onDelete: Restrict)

  // A subtask is a task with a parent: one level deep, so a board never has to render a tree.
  parentId String?
  parent   Task?   @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("TaskSubtasks")

  // Human handle for a task inside its project: #14 is stable even after a rename.
  taskNumber  Int
  name        String
  description String?
  // urgent | high | normal | low
  priority    String  @default("normal")
  startDate   DateTime?
  dueDate     DateTime?
  // Sparse float so a drop between two rows is one UPDATE; the service renormalizes a list
  // once neighbours get too close to halve again.
  position    Float
  completedAt DateTime?
  isArchived  Boolean   @default(false)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignees   TaskAssignee[]
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@unique([projectId, taskNumber])
  @@index([organizationId, listId, isArchived])
  @@index([parentId])
  @@index([statusId])
  @@map("task")
  @@schema("tasks")
}

// Who is doing it. Keyed by user rather than member: everything else in this app resolves a
// person by user id, and a member row is per organization anyway.
model TaskAssignee {
  id     String @id @default(uuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
  @@map("taskAssignee")
  @@schema("tasks")
}

// The conversation on a task. Flat rather than threaded: a task is already the thread, and a
// reply tree on work this small buys nothing but a harder read.
model TaskComment {
  id             String @id @default(uuid())
  organizationId String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  body     String
  // Set on the first edit, so the UI can say "edited" without comparing timestamps that a
  // trigger or a backfill could move on their own.
  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentions    TaskCommentMention[]
  attachments TaskAttachment[]

  @@index([taskId, createdAt])
  @@index([organizationId])
  @@map("taskComment")
  @@schema("tasks")
}

// Who a comment called on. Its own table rather than an array column because the unread badge
// is a query by user, and readAt has to live somewhere per person.
model TaskCommentMention {
  id        String      @id @default(uuid())
  commentId String
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([commentId, userId])
  @@index([userId, readAt])
  @@map("taskCommentMention")
  @@schema("tasks")
}

// A file on a task, or on one comment of it. taskId is always set even for a comment's file,
// so the task's own list can show everything attached to it without a join through comments.
model TaskAttachment {
  id             String @id @default(uuid())
  organizationId String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  commentId String?
  comment   TaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // The S3 object key; the file itself never touches Postgres.
  fileKey     String
  fileName    String
  contentType String
  fileSize    Int

  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([commentId])
  @@map("taskAttachment")
  @@schema("tasks")
}
