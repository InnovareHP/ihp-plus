# ---- Postgres ----
# A native Postgres install on the host also owns 5432 and silently wins, giving
# "password authentication failed for user ihp" (28P01) against a container that is
# perfectly fine. Move this to 55432 and change the port in DATABASE_URL to match.
POSTGRES_USER=ihp
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=ihp_plus
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- App wiring ----
# host dev (apps run on host, infra in docker)
# Nothing derives this from POSTGRES_PORT — change both together or the app talks to
# a different server than the one compose published.
DATABASE_URL=postgresql://ihp:change_me_locally@localhost:5432/ihp_plus
REDIS_URL=redis://localhost:6379

# inside docker compose network, use service names instead:
# DATABASE_URL=postgresql://ihp:change_me_locally@postgres:5432/ihp_plus
# REDIS_URL=redis://redis:6379

# ---- Object storage (profile photos) ----
# `pnpm infra:up` runs MinIO, which speaks the S3 API — no AWS account needed locally.
# MinIO refuses to start without a root password, so this one has no default anywhere.
S3_SECRET_ACCESS_KEY=change_me_locally_min_8_chars
S3_ACCESS_KEY_ID=ihp
S3_BUCKET=ihp-plus
S3_REGION=us-east-1
S3_PORT=9000
S3_CONSOLE_PORT=9001
# host dev: the app and the browser both reach MinIO on the published port.
S3_ENDPOINT=http://localhost:9000
# Path-style addressing: bucket.localhost does not resolve, and MinIO wants it anyway.
S3_FORCE_PATH_STYLE=true
# Inside compose the app talks to http://minio:9000, but a presigned link is opened by the
# browser, and SigV4 signs the Host header — so read links are signed for this origin instead.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# Real S3: drop S3_ENDPOINT and S3_FORCE_PATH_STYLE, keep the bucket, region and IAM keys.
# The keys need s3:PutObject, s3:GetObject and s3:DeleteObject on arn:aws:s3:::<bucket>/*

# ---- Organization seed (pnpm db:seed) ----
# One organization is the company; each department is a team inside it. Re-running the
# seed is safe. The owner is only assigned once that address has actually signed up.
ORG_NAME=
ORG_SLUG=ihp
ORG_OWNER_EMAIL=

# ---- Public ----
NEXT_PUBLIC_SITE_URL=http://localhost
PROXY_PORT=80

# ---- Better Auth ----
# Origin the browser actually hits. Host dev: the Next port. Full stack: the nginx proxy.
#   openssl rand -base64 32   (or: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=change_me_at_least_32_chars_long
BETTER_AUTH_URL=http://localhost:3000
# inside docker compose the proxy is the origin:
# BETTER_AUTH_URL=http://localhost

# ---- Microsoft Entra ID (Outlook sign-in) ----
# Register a Web app at https://entra.microsoft.com and add this exact redirect URI:
#   http://localhost:3000/app/api/auth/callback/microsoft   (host dev)
#   http://localhost/app/api/auth/callback/microsoft        (full stack via the proxy)
# 'common' = any work/school Entra account plus personal Outlook.com accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---- Microsoft Graph (SharePoint document sync) ----
# A SECOND app registration, separate from the sign-in one above: app-only (client credentials),
# and Sites.Selected must not sit beside a broad scope like Sites.ReadWrite.All or the narrow
# grant stops applying. An admin then grants it write on each site with
#   POST /sites/{siteId}/permissions
# Unset GRAPH_TENANT_ID (or leave it 'common') and every drive call reports "not configured".
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Dev only. Entra caps a secret at 24 months, so production uses the certificate pair below.
GRAPH_CLIENT_SECRET=
# PEM with its newlines escaped as 
, plus the SHA-1 thumbprint Entra shows for the cert.
# GRAPH_CLIENT_CERT_PRIVATE_KEY=
# GRAPH_CLIENT_CERT_THUMBPRINT=
# The two document libraries: staff write in the internal one, clients are shared folders in the
# client one. `pnpm graph:sites` lists both once the app has its grants; without them, open the
# site signed in and read <tenant>.sharepoint.com/sites/<site>/_api/v2.0/drives — the Documents
# entry's `id` (a long b!... string) is the value. The site id an admin grants on is composed
# from three parts: <tenant>.sharepoint.com,<_api/site/id>,<_api/web/id>
GRAPH_INTERNAL_DRIVE_ID=
GRAPH_CLIENT_DRIVE_ID=
# Where Graph posts change notifications. It must be public HTTPS, so local development needs a
# tunnel; unset, it falls back to BETTER_AUTH_URL + /app/api/graph/drive.
# GRAPH_NOTIFICATION_URL=
# Bearer token for POST /app/api/graph/renew. A drive subscription lapses after 4230 minutes and
# this repo has no worker, so an external scheduler has to call that route daily.
GRAPH_CRON_SECRET=
# Where a client lands after redeeming their guest invitation. Entra rejects anything but a
# well-formed https URL, so on a http://localhost portal this falls back to Microsoft My Apps.
# GRAPH_INVITE_REDIRECT_URL=https://portal.example.com/app
# How a client folder is shared. `guest` (the default) invites the address as a B2B guest, so
# every grant is a named person the folder access page can revoke. `link` creates an anonymous
# view link instead: no sign-in, but nothing ties the access to anyone, and the tenant must
# allow "Anyone" links. GRAPH_LINK_EXPIRY_DAYS bounds those links; unset, they never lapse.
# GRAPH_SHARE_MODE=link
# GRAPH_LINK_EXPIRY_DAYS=30

# ---- Transactional email (Amazon SES) ----
# EMAIL_FROM is the switch: unset it and verification, reset and invitation mail is written to
# the server log instead of sent, so local development needs no AWS account.
# The address (or its domain) must be a verified identity in SES, and a new account is in the
# sandbox until you request production access — it can only mail verified addresses.
EMAIL_FROM=
# Optional. Where a reply goes if it is not the from address.
EMAIL_REPLY_TO=
SES_REGION=us-east-1
# Falls back to AWS_REGION when SES_REGION is unset, which is what a task role already sets.
AWS_REGION=us-east-1
# Omit both on ECS/Lambda: the SDK resolves the task role, which beats long-lived keys in env.
# The IAM policy needs ses:SendEmail on the identity.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional. The SES configuration set that routes bounce and complaint events.
SES_CONFIGURATION_SET=

# ---- Stripe ----
# Unset: the webhook answers 500 so events keep being retried rather than silently dropped,
# and nothing in the portal attaches billing to a contract.
# Use a restricted key (rk_…) rather than a secret key (sk_…) — it needs write on Customers,
# Products, Subscriptions, Invoices and Invoice Items, which marking a contract agreed creates.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/app/api/stripe/webhook` in dev, or the
# endpoint's signing secret in the dashboard. Never the API key.
STRIPE_WEBHOOK_SECRET=

# ---- PostHog ----
# Unset: track() logs in development and sends nothing. Baked into the client bundle at build time,
# so a change needs a rebuild. Recording and autocapture stay off; only explicit track() events go.
NEXT_PUBLIC_POSTHOG_KEY=
# EU projects use https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
